{
  "name": "herdr-team",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Markdown-defined agent teams for herdr-core and Herdr",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "check": "npm run build && tsc --noEmit",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts",
    "verify:core": "npm run build && node --experimental-strip-types scripts/verify-core.ts",
    "verify:herdr": "npm run build && node --experimental-strip-types scripts/verify-herdr.ts",
    "verify:agents": "npm run build && node --experimental-strip-types scripts/verify-agents.ts",
    "format": "prettier --write src test \"scripts/*.ts\" package.json package-lock.json \"tsconfig*.json\" .github/workflows/ci.yml",
    "format:check": "prettier --check src test \"scripts/*.ts\" package.json package-lock.json \"tsconfig*.json\" .github/workflows/ci.yml"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.12",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  }
}
